Func RestoreAudioDefaults($bForceDisable = True)
    If $SVV = "" Or Not FileExists($SVV) Then Return

    If $bAudioSwitched Then
        If FileExists($BACKUP_PROFILE) Then
            RunWait('"' & $SVV & '" /LoadProfile "' & $BACKUP_PROFILE & '"', $ENGINE_DIR, @SW_HIDE)
            FileDelete($BACKUP_PROFILE)
        Else
            RunWait('"' & $SVV & '" /SetDefault "Speakers" all', $ENGINE_DIR, @SW_HIDE)
        EndIf
        $bAudioSwitched = False
    EndIf

    If $bForceDisable Then
        DisableAllVirtualEndpoints()
    EndIf
EndFunc   ;==>RestoreAudioDefaults

; ------------------------------------------------------------------------------
; Siapkan output audio Windows tanpa memblokir paksa saat --check tidak cocok.
; Return: 0 = lanjut jalankan engine, -2 = exe tidak bisa dijalankan
; ------------------------------------------------------------------------------
Func EnsureAudioOutputReady()
    Local $sOut = "", $iTry = 0, $iErr = 0, $bRecognized = False

    SetBusy("MENYIAPKAN OUTPUT AUDIO...")
    SetProgress(35, "Memeriksa status output audio...")
    $sOut = RunCapture('"' & $CAPTURE & '" --check', 7000)
    $iErr = @error
    If $iErr = 1 Then Return -2
    If $iErr = 2 Then
        KillStrayEngines()
        LogInfo("[!] YunuCapture.exe tidak mengenal --check, lanjut menyambung langsung...")
        Return 0
    EndIf

    $bRecognized = (StringRegExp($sOut, "\[(ACTIVE|DISABLED|NOTPRESENT|UNPLUGGED|OTHER)\]") = 1)
    If StringInStr($sOut, "[ACTIVE]") Then Return 0

    If Not $bRecognized And HasAnyActiveRenderEndpoint() Then
        Return 0
    EndIf

    LogInfo("[!] Output audio aktif belum terdeteksi. Mencoba mengaktifkan...")
    SetProgress(45, "Mengaktifkan output YunuAudio...")
    RemedyEnableOutput()

    For $iTry = 1 To 3
        PumpWait(1000)
        If $bRecognized Then
            $sOut = RunCapture('"' & $CAPTURE & '" --check', 7000)
            If StringInStr($sOut, "[ACTIVE]") Then
                LogInfo("[V] Output audio sudah aktif.")
                Return 0
            EndIf
        EndIf
        If HasAnyActiveRenderEndpoint() Then
            LogInfo("[V] Output audio aktif terdeteksi di Windows.")
            Return 0
        EndIf
    Next

    If $bRecognized Then
        LogInfo("[!] Info perangkat dari --check:")
        LogDeviceList($sOut)
    EndIf
    If $bDriverJustInstalled Then
        LogInfo("[!] Driver virtual baru dipasang. Jika gagal menangkap suara, restart PC sekali.")
    EndIf
    LogInfo("Tetap mencoba menyambungkan engine audio...")
    Return 0
EndFunc   ;==>EnsureAudioOutputReady

Func RemedyEnableOutput()
    Local $aRender = FindVirtualEndpointGuids("Render")
    Local $aIds[2] = [$APP_AUDIO_NAME, $CABLE_NAME]
    Local $i = 0, $sEpId = ""

    RunCapture('sc start AudioEndpointBuilder', 6000)
    RunCapture('sc start Audiosrv', 6000)

    If $SVV <> "" And FileExists($SVV) Then
        For $i = 0 To UBound($aRender) - 1
            $sEpId = "{0.0.0.00000000}." & $aRender[$i]
            RunWait('"' & $SVV & '" /Enable "' & $sEpId & '"', $ENGINE_DIR, @SW_HIDE)
            RunWait('"' & $SVV & '" /Unmute "' & $sEpId & '"', $ENGINE_DIR, @SW_HIDE)
            RunWait('"' & $SVV & '" /SetVolume "' & $sEpId & '" 100', $ENGINE_DIR, @SW_HIDE)
            RunWait('"' & $SVV & '" /SetDefault "' & $sEpId & '" all', $ENGINE_DIR, @SW_HIDE)
        Next
        If UBound($aRender) = 0 Then
            For $i = 0 To UBound($aIds) - 1
                RunWait('"' & $SVV & '" /Enable "' & $aIds[$i] & '"', $ENGINE_DIR, @SW_HIDE)
                RunWait('"' & $SVV & '" /Unmute "' & $aIds[$i] & '"', $ENGINE_DIR, @SW_HIDE)
                RunWait('"' & $SVV & '" /SetVolume "' & $aIds[$i] & '" 100', $ENGINE_DIR, @SW_HIDE)
                RunWait('"' & $SVV & '" /SetDefault "' & $aIds[$i] & '" all', $ENGINE_DIR, @SW_HIDE)
            Next
        EndIf
        $bAudioSwitched = True
    EndIf
EndFunc   ;==>RemedyEnableOutput

Func LogDeviceList($sOut)
    Local $a = StringRegExp($sOut, "(?m)^\s*\[(ACTIVE|DISABLED|NOTPRESENT|UNPLUGGED|OTHER)\]\s*(.*?)\s*$", 3)
    Local $i = 0
    If @error Then
        LogInfo("    (tidak ada daftar perangkat dari --check)")
        Return
    EndIf
    For $i = 0 To UBound($a) - 2 Step 2
        LogInfo("    [" & $a[$i] & "] " & $a[$i + 1])
    Next
EndFunc   ;==>LogDeviceList

; ==============================================================================
; LOGIKA SAMBUNGAN AUDIO
; ==============================================================================

Func ConnectAudio($bManual = False)
    Local $sSerial = "", $iCheck = 0, $sRev = ""

    If $IsConnected Then Return True
    If $bManual Then $AutoSuppressed = False

    SetBusy("MENYAMBUNGKAN...")
    SetProgress(10, "Memeriksa koneksi HP lewat USB...")
    LogInfo("Memeriksa kabel USB...")

    $sSerial = GetDeviceStatus()
    $LastStatus = $sSerial

    If $sSerial = "NO_DEVICE" Then
        SetStateDisconnected("HP BELUM DICOLOK")
        SetProgress(0, "HP belum terdeteksi.")
        LogInfo("[X] HP tidak terdeteksi. Colokkan kabel USB!")
        Return False
    ElseIf $sSerial = "UNAUTHORIZED" Then
        SetStateDisconnected("IZINKAN DI LAYAR HP")
        SetProgress(0, "Izinkan USB Debugging di layar HP.")
        LogInfo("[!] Centang 'Selalu izinkan' pada pop-up di layar HP.")
        Return False
    ElseIf $sSerial = "OFFLINE" Then
        SetStateDisconnected("HP OFFLINE")
        SetProgress(0, "HP offline, coba cabut-colok kabel.")
        LogInfo("[!] HP offline. Cabut dan colok ulang kabel USB.")
        Return False
    EndIf

    $DeviceSerial = $FoundSerial
    LogInfo("HP terdeteksi: " & $DeviceSerial)

    If $CAPTURE = "" Or Not FileExists($CAPTURE) Then
        SetProgress(0, "YunuCapture.exe tidak ditemukan.")
        Return ConnectFail("ENGINE AUDIO HILANG", "[X] YunuCapture.exe tidak ditemukan di folder Engine.")
    EndIf

    ; 1. Pastikan output YunuAudio aktif & default Windows
    SetProgress(25, "Memastikan output YunuAudio aktif...")
    ActivateAndUnmuteVirtualAudio(True)
    PumpWait(200)

    ; 2. Cek output audio Windows (non-blocking)
    $iCheck = EnsureAudioOutputReady()
    If $iCheck = -2 Then
        SetProgress(0, "Engine audio gagal dijalankan.")
        Return ConnectFail("ENGINE AUDIO GAGAL", "[X] YunuCapture.exe tidak bisa dijalankan (butuh Windows 64-bit).")
    EndIf

    ; 3. Pastikan APK terpasang di HP
    SetProgress(55, "Memeriksa aplikasi YunuAudio di HP...")
    If Not EnsureReceiverInstalled() Then
        SetProgress(0, "Gagal memasang APK.")
        Return ConnectFail("GAGAL PASANG APK", "")
    EndIf

    ; 4. Bersihkan sisa sesi lama
    SetBusy("MENYAMBUNGKAN...")
    SetProgress(70, "Membersihkan sesi sambungan sebelumnya...")
    Adb('shell am stopservice -n ' & $SVC, 3000)
    Adb('reverse --remove tcp:' & $PORT, 3000)
    StopEngine()
    KillStrayEngines()
    PumpWait(300)

    ; 5. Jembatan port USB
    SetProgress(82, "Membuat jembatan port USB...")
    Adb('reverse tcp:' & $PORT & ' tcp:' & $PORT, 5000)
    $sRev = Adb('reverse --list', 4000)
    If Not StringInStr($sRev, "tcp:" & $PORT) Then
        SetProgress(0, "Jembatan port USB gagal.")
        Return ConnectFail("ADB REVERSE GAGAL", "[X] Gagal membuat jembatan port USB: " & CleanLine($sRev))
    EndIf

    ; 6. Nyalakan penangkap audio PC dulu
    SetProgress(90, "Menyalakan penangkap audio PC...")
    If Not StartCaptureEngine() Then
        SetProgress(0, "Engine audio berhenti.")
        Return ConnectFail("ENGINE AUDIO GAGAL", "")
    EndIf
    PumpWait(300)

    ; 7. Nyalakan service di HP
    SetProgress(96, "Menyalakan penerima suara di HP...")
    If Not StartPhoneService() Then
        SetProgress(0, "Service HP gagal dijalankan.")
        Return ConnectFail("SERVICE HP GAGAL", "")
    EndIf

    ResetDiagnostics()
    $iRestarts = 0
    $tWatch = TimerInit()
    $tDeep = TimerInit()
    SetStateConnected()
    SetProgress(100, "Tersambung! Suara PC dialirkan ke HP.")
    LogInfo("[V] Tersambung. Putar suara/video di PC sekarang.")
    LogInfo("    (Naikkan juga volume MEDIA di HP.)")
    Return True
EndFunc   ;==>ConnectAudio

Func ConnectFail($sShort, $sLog)
    StopEngine()
    If $DeviceSerial <> "" Then
        Adb('shell am stopservice -n ' & $SVC, 3000)
        Adb('reverse --remove tcp:' & $PORT, 3000)
    EndIf
    SetStateDisconnected($sShort)
    If $sLog <> "" Then LogInfo($sLog)
    If $AutoSuppressed = False Then LogInfo("Auto-connect dijeda. Klik tombol untuk coba lagi.")
    $AutoSuppressed = True
    Return False
EndFunc   ;==>ConnectFail

Func DisconnectAudio($bUser = True)
    StopEngine()
    If $DeviceSerial <> "" Then
        Adb('shell am stopservice -n ' & $SVC, 4000)
        Adb('reverse --remove tcp:' & $PORT, 4000)
    EndIf
    ResetDiagnostics()
    SetStateDisconnected("TERPUTUS")
    SetProgress(0, "Sambungan diputus.")
    $AutoSuppressed = $bUser
    LogInfo("Sambungan diputus.")
EndFunc   ;==>DisconnectAudio

Func HandleUnplug()
    StopEngine()
    ResetDiagnostics()
    SetStateDisconnected("KABEL DICABUT")
    SetProgress(0, "Kabel USB dicabut.")
    $AutoSuppressed = False
    $LastStatus = "NO_DEVICE"
    LogInfo("[!] Kabel USB dicabut. Menunggu dicolok lagi...")
EndFunc   ;==>HandleUnplug

; ------------------------------------------------------------------------------
; Pemantauan saat idle (belum tersambung): deteksi HP + auto-connect
; ------------------------------------------------------------------------------
Func PollIdle()
    Local $sStat = ""

    $tIdle = TimerInit()
    $sStat = GetDeviceStatus()

    If $sStat <> $LastStatus Then
        $LastStatus = $sStat
        Switch $sStat
            Case "NO_DEVICE"
                SetStateDisconnected("HP BELUM DICOLOK")
                SetProgress(0, "Menunggu kabel USB dicolok...")
                LogInfo("Menunggu kabel USB dicolok...")
            Case "UNAUTHORIZED"
                SetStateDisconnected("IZINKAN DI LAYAR HP")
                SetProgress(0, "Izinkan USB Debugging di layar HP.")
                LogInfo("[!] Muncul pop-up di layar HP, centang 'Selalu izinkan' lalu OK.")
            Case "OFFLINE"
                SetStateDisconnected("HP OFFLINE")
                SetProgress(0, "HP offline, cabut-colok ulang kabel USB.")
                LogInfo("[!] HP offline. Cabut dan colok ulang kabel USB.")
            Case "READY"
                SetStateDisconnected("HP SIAP")
                SetProgress(0, "HP terdeteksi, siap menyambungkan.")
                LogInfo("HP terdeteksi: " & $FoundSerial)
        EndSwitch
    EndIf

    If $sStat <> "READY" Then $AutoSuppressed = False

    If $sStat = "READY" And GUICtrlRead($chkAuto) = $GUI_CHECKED And Not $AutoSuppressed Then
        ConnectAudio(False)
    EndIf
EndFunc   ;==>PollIdle

; ------------------------------------------------------------------------------
; Pemantauan saat tersambung: penangkap audio, kabel USB, service di HP
; ------------------------------------------------------------------------------
Func WatchConnected()
    Local $iExit = -1
    Local $sWhy = "ENGINE AUDIO ERROR"
    Local $sOut = ""

    $tWatch = TimerInit()

    ; --- 1. Engine penangkap audio ---
    If ProcessExists($hEngine) Then
        If TimerDiff($tEngineStart) > 30000 Then $iRestarts = 0
    Else
        DrainEngineOutput()
        $iExit = ProcExitCode($hEngineProc)
        CloseH($hEngineProc)
        $hEngineProc = 0
        $hEngine = 0

        If $iExit = 10 Or $iExit = 11 Or $iExit = 2 Then
            If $iExit = 10 Then $sWhy = "TIDAK ADA OUTPUT AUDIO"
            If $iExit = 11 Then $sWhy = "WASAPI ERROR"
            If $iExit = 2 Then $sWhy = "PORT TERPAKAI"
            LogInfo("[X] Penangkap audio berhenti (kode " & $iExit & ") dan tidak bisa dipulihkan otomatis.")
            DisconnectAudio(True)
            SetStateDisconnected($sWhy)
            Return
        EndIf

        $iRestarts += 1
        If $iRestarts > 5 Then
            LogInfo("[X] Penangkap audio berhenti berulang kali.")
            DisconnectAudio(True)
            SetStateDisconnected("ENGINE AUDIO ERROR")
            Return
        EndIf
        LogInfo("Aliran audio terputus (kode " & $iExit & "), memulai ulang (" & $iRestarts & "/5)...")
        If Not StartCaptureEngine() Then
            DisconnectAudio(True)
            SetStateDisconnected("ENGINE AUDIO ERROR")
            Return
        EndIf
    EndIf

    ; --- 2. HP tidak kunjung terhubung ke PC ---
    If Not $bPhoneConnected And Not $bWarnNoPhone And TimerDiff($tEngineStart) > 8000 Then
        $bWarnNoPhone = True
        LogInfo("[!] HP belum terhubung ke PC setelah 8 detik.")
        If ServiceAlive() Then
            LogInfo("    Service HP berjalan. Jembatan USB: " & CleanLine(Adb('reverse --list', 3000)))
        Else
            LogInfo("    Service di HP tidak berjalan. Menyalakan ulang...")
            StartPhoneService()
        EndIf
    EndIf

    ; --- 3. Pemeriksaan lebih berat tiap 4 detik (beri waktu inisialisasi awal 5 detik) ---
    If TimerDiff($tEngineStart) > 5000 And TimerDiff($tDeep) > 4000 Then
        $tDeep = TimerInit()
        $sOut = RunCapture('"' & $ADB & '" devices', 5000)
        If Not @error Then
            If Not StringRegExp($sOut, "(?m)^\Q" & $DeviceSerial & "\E\s+device\s*$") Then
                HandleUnplug()
                Return
            EndIf
        EndIf
        If Not ServiceAlive() Then
            LogInfo("Service di HP berhenti, menyalakan ulang...")
            StartPhoneService()
        EndIf
    EndIf
EndFunc   ;==>WatchConnected

; ==============================================================================
; DIAGNOSTIK ALIRAN AUDIO (membaca pesan & statistik dari YunuCapture.exe)
; ==============================================================================

Func ResetDiagnostics()
    $bPhoneConnected = False
    $bWarnNoPhone = False
    $bWarnNoData = False
    $bWarnSilent = False
    $iStatBytes = 0
    $iStatPeak = 0
    $tLastGrow = TimerInit()
    $tLastPeak = TimerInit()
    $sCapDev = "?"
    $sLastLevelTxt = ""
EndFunc   ;==>ResetDiagnostics

Func DrainEngineOutput()
    Local $s = "", $aLines = 0, $n = 0, $i = 0

    If $hEngine = 0 Then Return
    $s = StdoutRead($hEngine)
    If $s = "" Then Return

    $sEngBuf &= $s
    $aLines = StringSplit(StringReplace($sEngBuf, @CR, ""), @LF, 2)
    $n = UBound($aLines)
    $sEngBuf = $aLines[$n - 1]

    For $i = 0 To $n - 2
        HandleEngineLine($aLines[$i])
    Next
EndFunc   ;==>DrainEngineOutput

Func HandleEngineLine($sLine)
    Local $aM = 0, $aD = 0, $iB = 0

    $sLine = StringStripWS($sLine, 3)
    If $sLine = "" Then Return

    $aM = StringRegExp($sLine, "^STAT\s+(\d+)\s+(\d+)", 1)
    If Not @error Then
        $iB = Number($aM[0])
        If $iB > $iStatBytes Then
            $tLastGrow = TimerInit()
            $bWarnNoData = False
        EndIf
        $iStatBytes = $iB
        $iStatPeak = Int($aM[1])
        If $iStatPeak > 0 Then
            $tLastPeak = TimerInit()
            $bWarnSilent = False
        EndIf
        Return
    EndIf

    If StringInStr($sLine, "HP terhubung.") Then
        $bPhoneConnected = True
        $tLastGrow = TimerInit()
        $tLastPeak = TimerInit()
        LogInfo("[V] HP sudah terhubung ke PC (jalur USB OK).")
        Return
    EndIf

    If StringInStr($sLine, "Merekam dari:") Then
        $aD = StringRegExp($sLine, "Merekam dari:\s*(.*?)\s*\|", 1)
        If Not @error Then $sCapDev = $aD[0]
        LogInfo(StringReplace($sLine, "[capture] ", ""))
        Return
    EndIf

    If $iEngineLog < 8 Then
        $iEngineLog += 1
        LogInfo(CleanLine($sLine))
    EndIf
EndFunc   ;==>HandleEngineLine

Func UpdateLevelLabel()
    Local $sTxt = ""

    $tLevel = TimerInit()

    If Not $bPhoneConnected Then
        $sTxt = "Menunggu HP terhubung ke PC..."
    ElseIf TimerDiff($tLastGrow) > 3000 Then
        $sTxt = "HP terhubung, tapi PC belum mengirim suara"
        If Not $bWarnNoData And TimerDiff($tLastGrow) > 8000 Then
            $bWarnNoData = True
            LogInfo("[!] Tidak ada data audio dari output '" & $sCapDev & "'.")
            LogInfo("    Putar suara di PC. Kalau sudah diputar, aplikasi itu tidak memakai")
            LogInfo("    output default Windows (cek Settings > Sound > Volume mixer).")
        EndIf
    ElseIf TimerDiff($tLastPeak) > 5000 Then
        $sTxt = "Data masuk tapi HENING (cek volume/mute)"
        If Not $bWarnSilent And TimerDiff($tLastPeak) > 8000 Then
            $bWarnSilent = True
            LogInfo("[!] Data audio mengalir tapi isinya hening (output '" & $sCapDev & "').")
            LogInfo("    Cek volume aplikasi pemutar & mute di Volume mixer Windows.")
        EndIf
    Else
        $sTxt = "Suara mengalir | level " & $iStatPeak & "%"
    EndIf

    If $sTxt <> $sLastLevelTxt Then
        $sLastLevelTxt = $sTxt
        GUICtrlSetData($lblLevel, $sTxt)
    EndIf
EndFunc   ;==>UpdateLevelLabel

; ==============================================================================
; ANDROID / ADB
; ==============================================================================

Func Adb($sArgs, $iTimeout = 8000)
    Local $sCmd = '"' & $ADB & '"'
    If $DeviceSerial <> "" Then $sCmd &= ' -s "' & $DeviceSerial & '"'
    Return RunCapture($sCmd & ' ' & $sArgs, $iTimeout)
EndFunc   ;==>Adb

Func GetDeviceStatus()
    Local $sOut = "", $aM = 0

    $FoundSerial = ""
    $sOut = RunCapture('"' & $ADB & '" devices', 8000)

    $aM = StringRegExp($sOut, "(?m)^(\S+)\s+device\s*$", 1)
    If Not @error Then
        $FoundSerial = $aM[0]
        Return "READY"
    EndIf
    If StringRegExp($sOut, "(?m)^\S+\s+unauthorized\s*$") Then Return "UNAUTHORIZED"
    If StringRegExp($sOut, "(?m)^\S+\s+offline\s*$") Then Return "OFFLINE"
    Return "NO_DEVICE"
EndFunc   ;==>GetDeviceStatus

Func EnsureReceiverInstalled()
    Local $sOut = Adb('shell pm list packages ' & $PKG, 5000)

    If Not StringInStr($sOut, "package:" & $PKG) Then
        If $APK = "" Or Not FileExists($APK) Then
            LogInfo("[X] YunuAudio.apk tidak ditemukan di folder Engine.")
            Return False
        EndIf
        SetBusy("MEMASANG APK...")
        SetProgress(60, "Memasang aplikasi YunuAudio di HP...")
        LogInfo("Memasang YunuAudio di HP (hanya sekali)...")
        $sOut = Adb('install -r -g "' & $APK & '"', 60000)
        If Not StringInStr($sOut, "Success") Then
            $sOut = Adb('install -r "' & $APK & '"', 60000)
        EndIf
        If Not StringInStr($sOut, "Success") Then
            LogInfo("[X] Gagal memasang APK: " & CleanLine($sOut))
            LogInfo("    (Xiaomi/Oppo/Vivo: aktifkan 'Install via USB' di Opsi Pengembang)")
            Return False
        EndIf
        LogInfo("[V] APK receiver terpasang.")
    EndIf
    Adb('shell pm grant ' & $PKG & ' android.permission.POST_NOTIFICATIONS', 4000)
    Return True
EndFunc   ;==>EnsureReceiverInstalled

Func StartPhoneService()
    Local $sExtra = ""
    Local $sOut = ""

    If $PORT <> 8080 Then $sExtra = " --ei port " & $PORT

    $sOut = Adb('shell am start-foreground-service -n ' & $SVC & $sExtra, 5000)
    If StringRegExp($sOut, "(?i)error|exception|unknown command|usage") Then
        $sOut = Adb('shell am startservice -n ' & $SVC & $sExtra, 5000)
    EndIf
    If StringRegExp($sOut, "(?i)error|exception|unknown command|usage") Then
        LogInfo("[X] Service HP gagal dijalankan: " & CleanLine($sOut))
        Return False
    EndIf
    Return True
EndFunc   ;==>StartPhoneService

Func ServiceAlive()
    Local $s = Adb('shell pidof ' & $PKG, 5000)

    If @error Then Return True
    If StringRegExp($s, "\d+") Then Return True
    If StringRegExp($s, "(?i)not found|inaccessible|unknown|error|usage") Then Return True
    Return False
EndFunc   ;==>ServiceAlive

; ==============================================================================
; ENGINE AUDIO PC (YunuCapture.exe - WASAPI loopback)
; ==============================================================================

Func StartCaptureEngine()
    Local $iExit = -1
    Local $sLeft = ""

    If $CAPTURE = "" Or Not FileExists($CAPTURE) Then
        LogInfo("[X] YunuCapture.exe tidak ditemukan.")
        Return False
    EndIf

    StopEngine()
    $sEngBuf = ""
    $hEngine = Run('"' & $CAPTURE & '" ' & $PORT, $ENGINE_DIR, @SW_HIDE, BitOR($STDOUT_CHILD, $STDERR_MERGED))
    If $hEngine = 0 Then
        LogInfo("[X] YunuCapture.exe tidak bisa dijalankan.")
        Return False
    EndIf
    $hEngineProc = OpenProc($hEngine)

    $tEngineStart = TimerInit()
    $iEngineLog = 0
    $bPhoneConnected = False
    $bWarnNoPhone = False

    PumpWait(600)
    If Not ProcessExists($hEngine) Then
        DrainEngineOutput()
        $sLeft = CleanLine($sEngBuf)
        $iExit = ProcExitCode($hEngineProc)
        LogInfo("[X] Penangkap audio langsung berhenti (kode " & $iExit & ").")
        If $sLeft <> "" Then LogInfo("    Detail: " & $sLeft)
        If $iExit = 2 Then LogInfo("    Port " & $PORT & " dipakai program lain. Ubah Port di YunuAudio.ini.")
        If $iExit = 10 Then
            LogInfo("    Tidak ada output audio aktif di Windows.")
            If $bDriverJustInstalled Then LogInfo("    Driver baru dipasang: coba RESTART PC sekali.")
        EndIf
        CloseH($hEngineProc)
        $hEngineProc = 0
        $hEngine = 0
        Return False
    EndIf
    Return True
EndFunc   ;==>StartCaptureEngine

Func StopEngine()
    If $hEngine <> 0 Then
        ProcessClose($hEngine)
        $hEngine = 0
    EndIf
    If $hEngineProc <> 0 Then
        CloseH($hEngineProc)
        $hEngineProc = 0
    EndIf
EndFunc   ;==>StopEngine

Func KillStrayEngines()
    Local $i = 0
    While ProcessExists("YunuCapture.exe") And $i < 10
        ProcessClose("YunuCapture.exe")
        Sleep(100)
        $i += 1
    WEnd
EndFunc   ;==>KillStrayEngines

Func OpenProc($iPID)
    Local $a = DllCall("kernel32.dll", "handle", "OpenProcess", "dword", 0x1000, "bool", False, "dword", $iPID)
    If @error Or Not IsArray($a) Then Return 0
    Return $a[0]
EndFunc   ;==>OpenProc

Func ProcExitCode($h)
    Local $a = 0

    If Not $h Then Return -1
    $a = DllCall("kernel32.dll", "bool", "GetExitCodeProcess", "handle", $h, "dword*", 0)
    If @error Or Not IsArray($a) Or Not $a[0] Then Return -1
    Return $a[2]
EndFunc   ;==>ProcExitCode

Func CloseH($h)
    If $h Then DllCall("kernel32.dll", "bool", "CloseHandle", "handle", $h)
EndFunc   ;==>CloseH

