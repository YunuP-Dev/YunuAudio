Func SetupVirtualAudioSafe()
    Local $aMedia = 0
    Local $aRender = 0
    Local $bRenamed = False
    Local $tWait = 0

    SetBusy("MENYIAPKAN OUTPUT...")
    SetProgress(8, "Memeriksa sisa output sesi sebelumnya...")
    PumpWait(150)

    ; 1. Bersihkan sisa output virtual jika masih ada/aktif dari sesi sebelumnya
    $aRender = FindVirtualEndpointGuids("Render")
    If FileExists($BACKUP_PROFILE) Or UBound($aRender) > 0 Then
        LogInfo("Membersihkan sisa output & konfigurasi sebelumnya...")
        SetProgress(18, "Menghapus sisa output sebelumnya...")
        If $SVV <> "" And FileExists($SVV) And FileExists($BACKUP_PROFILE) Then
            RunWaitSmooth('"' & $SVV & '" /LoadProfile "' & $BACKUP_PROFILE & '"', $ENGINE_DIR, 18, 25, 700)
            FileDelete($BACKUP_PROFILE)
        EndIf
        DisableAllVirtualOutput()
        PumpWait(250)
    EndIf

    ; 2. Cadangkan profil audio asli Windows (saat output virtual nonaktif)
    If $SVV <> "" And FileExists($SVV) Then
        SetProgress(32, "Mencadangkan konfigurasi audio asli...")
        RunWaitSmooth('"' & $SVV & '" /SaveProfile "' & $BACKUP_PROFILE & '"', $ENGINE_DIR, 32, 42, 600)
    EndIf

    ; 3. Pasang driver virtual jika belum terpasang, atau aktifkan ulang via PnPUtil
    $aMedia = FindVirtualMediaInstanceIds()
    If UBound($aMedia) = 0 Then
        If $VBCABLE_SETUP <> "" And FileExists($VBCABLE_SETUP) Then
            LogInfo("Memasang output audio YunuAudio (mohon tunggu)...")
            SetProgress(46, "Memasang driver output YunuAudio...")
            $bDriverJustInstalled = True
            RunWaitSmooth('"' & $VBCABLE_SETUP & '" -i -h', $ENGINE_DIR, 46, 68, 6000)

            $tWait = TimerInit()
            While UBound(FindVirtualEndpointGuids("Render")) = 0 And TimerDiff($tWait) < 12000
                PumpWait(400)
                SetProgress(70, "Menunggu Windows mengenali perangkat output...")
            WEnd
            $aMedia = FindVirtualMediaInstanceIds()
        Else
            LogInfo("[!] Driver output virtual tidak ditemukan di folder Engine.")
        EndIf
    Else
        SetProgress(55, "Mengaktifkan perangkat output YunuAudio...")
        EnableVirtualMediaDevices($aMedia)
        $tWait = TimerInit()
        While UBound(FindVirtualEndpointGuids("Render")) = 0 And TimerDiff($tWait) < 6000
            PumpWait(250)
        WEnd
    EndIf

    ; 4. Rename menjadi YunuAudio di MMDevices + Enum + refresh cache Windows Audio
    $aRender = FindVirtualEndpointGuids("Render")
    If UBound($aRender) > 0 Then
        SetProgress(78, "Mengubah nama output menjadi YunuAudio...")
        $bRenamed = RenameAllVirtualToYunuAudio()

        If $bRenamed Then
            SetProgress(86, "Menyegarkan nama YunuAudio di Windows...")
            RefreshAudioCache($aMedia)
        EndIf

        SetProgress(94, "Mengatur YunuAudio sebagai output aktif...")
        ActivateAndUnmuteVirtualAudio(True)

        If HasActiveVirtualEndpoint() Then
            LogInfo("Output '" & $APP_AUDIO_NAME & "' aktif dan siap.")
        Else
            LogInfo("Output '" & $APP_AUDIO_NAME & "' disiapkan (dicek ulang saat menyambung).")
        EndIf
    Else
        LogInfo("[!] Output virtual tidak terdeteksi. Memakai output audio bawaan Windows.")
    EndIf

    SetProgress(100, "Output YunuAudio siap digunakan.")
    PumpWait(250)
EndFunc   ;==>SetupVirtualAudioSafe

; Cari driver induk VB-Audio / YunuAudio di HKLM64\SYSTEM\CurrentControlSet\Enum\ROOT\MEDIA
Func FindVirtualMediaInstanceIds()
    Local $sBase = "HKEY_LOCAL_MACHINE64\SYSTEM\CurrentControlSet\Enum\ROOT\MEDIA"
    Local $aRes[0]
    Local $i = 1, $sSub = "", $sKey = ""
    Local $sDesc = "", $sMfg = "", $sFriend = "", $sSvc = "", $n = 0

    While 1
        $sSub = RegEnumKey($sBase, $i)
        If @error Then ExitLoop
        $sKey = $sBase & "\" & $sSub
        $sDesc = RegRead($sKey, "DeviceDesc")
        $sMfg = RegRead($sKey, "Mfg")
        $sFriend = RegRead($sKey, "FriendlyName")
        $sSvc = RegRead($sKey, "Service")

        If StringInStr($sDesc, "VB-Audio") Or StringInStr($sDesc, "CABLE") Or _
           StringInStr($sMfg, "VB-Audio") Or StringInStr($sFriend, $APP_AUDIO_NAME) Or _
           StringInStr($sSvc, "VBAudioVAC") Then
            $n = UBound($aRes)
            ReDim $aRes[$n + 1]
            $aRes[$n] = "ROOT\MEDIA\" & $sSub
        EndIf
        $i += 1
    WEnd
    Return $aRes
EndFunc   ;==>FindVirtualMediaInstanceIds

Func EnableVirtualMediaDevices($aMedia)
    Local $i = 0
    For $i = 0 To UBound($aMedia) - 1
        RunWaitSmooth('"' & $PNPUTIL & '" /enable-device "' & $aMedia[$i] & '"', $ENGINE_DIR, 56, 68, 900)
    Next
EndFunc   ;==>EnableVirtualMediaDevices

Func DisableVirtualMediaDevices($aMedia)
    Local $i = 0
    For $i = 0 To UBound($aMedia) - 1
        RunWait('"' & $PNPUTIL & '" /disable-device "' & $aMedia[$i] & '"', $ENGINE_DIR, @SW_HIDE)
    Next
EndFunc   ;==>DisableVirtualMediaDevices

Func DisableAllVirtualOutput()
    Local $aRender = FindVirtualEndpointGuids("Render")
    Local $aCapture = FindVirtualEndpointGuids("Capture")
    Local $aMedia = FindVirtualMediaInstanceIds()
    Local $i = 0

    If $SVV <> "" And FileExists($SVV) Then
        For $i = 0 To UBound($aRender) - 1
            RunWait('"' & $SVV & '" /Disable "{0.0.0.00000000}.' & $aRender[$i] & '"', $ENGINE_DIR, @SW_HIDE)
        Next
        For $i = 0 To UBound($aCapture) - 1
            RunWait('"' & $SVV & '" /Disable "{0.0.1.00000000}.' & $aCapture[$i] & '"', $ENGINE_DIR, @SW_HIDE)
        Next
    EndIf

    If UBound($aMedia) > 0 Then
        DisableVirtualMediaDevices($aMedia)
    EndIf
EndFunc   ;==>DisableAllVirtualOutput

Func RefreshAudioCache($aMedia)
    If UBound($aMedia) > 0 Then
        DisableVirtualMediaDevices($aMedia)
        PumpWait(300)
        EnableVirtualMediaDevices($aMedia)
        PumpWait(400)
    EndIf
    ; Gunakan '&' agar net start Audiosrv tetap jalan walau AudioEndpointBuilder sudah hidup
    RunWaitSmooth('cmd.exe /c net stop Audiosrv /y & net start AudioEndpointBuilder & net start Audiosrv', $ENGINE_DIR, 86, 93, 2000)
    PumpWait(300)
EndFunc   ;==>RefreshAudioCache

; $bFull = True : aktifkan + unmute + volume 100 + default. False : pastikan aktif & default.
Func ActivateAndUnmuteVirtualAudio($bFull = False)
    Local $aRender = FindVirtualEndpointGuids("Render")
    Local $i = 0, $sEpId = ""

    If $SVV = "" Or Not FileExists($SVV) Then Return
    If UBound($aRender) = 0 Then Return

    If $bFull Then
        For $i = 0 To UBound($aRender) - 1
            $sEpId = "{0.0.0.00000000}." & $aRender[$i]
            RunWait('"' & $SVV & '" /Enable "' & $sEpId & '"', $ENGINE_DIR, @SW_HIDE)
            RunWait('"' & $SVV & '" /Unmute "' & $sEpId & '"', $ENGINE_DIR, @SW_HIDE)
            RunWait('"' & $SVV & '" /SetVolume "' & $sEpId & '" 100', $ENGINE_DIR, @SW_HIDE)
        Next
    EndIf

    If HasActiveVirtualEndpoint() Then
        For $i = 0 To UBound($aRender) - 1
            $sEpId = "{0.0.0.00000000}." & $aRender[$i]
            RunWait('"' & $SVV & '" /SetDefault "' & $sEpId & '" all', $ENGINE_DIR, @SW_HIDE)
        Next
        $bAudioSwitched = True
    EndIf
EndFunc   ;==>ActivateAndUnmuteVirtualAudio

Func FindVirtualEndpointGuids($sType = "Render")
    Local $sBase = "HKEY_LOCAL_MACHINE64\SOFTWARE\Microsoft\Windows\CurrentVersion\MMDevices\Audio\" & $sType
    Local $aRes[0]
    Local $i = 1, $sSub = "", $sProp = ""
    Local $sDesc = "", $sIf = "", $sInf = "", $sPnp = "", $iState = 0
    Local $n = 0

    While 1
        $sSub = RegEnumKey($sBase, $i)
        If @error Then ExitLoop

        $sProp = $sBase & "\" & $sSub & "\Properties"
        $sDesc = RegRead($sProp, "{a45c254e-df1c-4efd-8020-67d146a850e0},2")
        $sIf = RegRead($sProp, "{b3f8fa53-0004-438e-9003-51a46e139bfc},6")
        $sInf = RegRead($sProp, "{83da6326-97a6-4088-9453-a1923f573b29},3")
        $sPnp = RegRead($sProp, "{b3f8fa53-0004-438e-9003-51a46e139bfc},2")

        If StringInStr($sDesc, "CABLE") Or StringInStr($sDesc, $APP_AUDIO_NAME) Or _
           StringInStr($sIf, "VB-Audio") Or StringInStr($sIf, $APP_AUDIO_NAME) Or _
           StringInStr($sInf, "vbaudio") Or StringInStr($sPnp, "vbaudio") Then

            $iState = BitAND(Number(RegRead($sBase & "\" & $sSub, "DeviceState")), 0xF)
            If $iState = 1 Or $iState = 2 Or $iState = 8 Then
                $n = UBound($aRes)
                ReDim $aRes[$n + 1]
                $aRes[$n] = $sSub
            EndIf
        EndIf
        $i += 1
    WEnd
    Return $aRes
EndFunc   ;==>FindVirtualEndpointGuids

Func HasActiveVirtualEndpoint()
    Local $sBase = "HKEY_LOCAL_MACHINE64\SOFTWARE\Microsoft\Windows\CurrentVersion\MMDevices\Audio\Render"
    Local $aRender = FindVirtualEndpointGuids("Render")
    Local $i = 0, $iState = 0

    For $i = 0 To UBound($aRender) - 1
        $iState = BitAND(Number(RegRead($sBase & "\" & $aRender[$i], "DeviceState")), 0xF)
        If $iState = 1 Then Return True
    Next
    Return False
EndFunc   ;==>HasActiveVirtualEndpoint

Func HasAnyActiveRenderEndpoint()
    Local $sBase = "HKEY_LOCAL_MACHINE64\SOFTWARE\Microsoft\Windows\CurrentVersion\MMDevices\Audio\Render"
    Local $i = 1, $sSub = "", $iState = 0

    While 1
        $sSub = RegEnumKey($sBase, $i)
        If @error Then ExitLoop
        $iState = BitAND(Number(RegRead($sBase & "\" & $sSub, "DeviceState")), 0xF)
        If $iState = 1 Then Return True
        $i += 1
    WEnd
    Return False
EndFunc   ;==>HasAnyActiveRenderEndpoint

; Rename semua registry endpoint & Enum ke YunuAudio memakai WinAPI native
Func RenameAllVirtualToYunuAudio()
    Local $aRender = FindVirtualEndpointGuids("Render")
    Local $aCapture = FindVirtualEndpointGuids("Capture")
    Local $aMedia = FindVirtualMediaInstanceIds()
    Local $bChanged = False
    Local $i = 0, $sRel = "", $sEnumRel = "", $sCur1 = "", $sCur2 = ""

    For $i = 0 To UBound($aRender) - 1
        $sRel = "SOFTWARE\Microsoft\Windows\CurrentVersion\MMDevices\Audio\Render\" & $aRender[$i] & "\Properties"
        $sCur1 = RegRead("HKEY_LOCAL_MACHINE64\" & $sRel, "{a45c254e-df1c-4efd-8020-67d146a850e0},2")
        $sCur2 = RegRead("HKEY_LOCAL_MACHINE64\" & $sRel, "{b3f8fa53-0004-438e-9003-51a46e139bfc},6")
        If $sCur1 <> $APP_AUDIO_NAME Or $sCur2 <> $APP_AUDIO_NAME Then
            If WriteProtectedReg($sRel, "{a45c254e-df1c-4efd-8020-67d146a850e0},2", $APP_AUDIO_NAME) Then $bChanged = True
            If WriteProtectedReg($sRel, "{b3f8fa53-0004-438e-9003-51a46e139bfc},6", $APP_AUDIO_NAME) Then $bChanged = True
        EndIf

        $sEnumRel = "SYSTEM\CurrentControlSet\Enum\SWD\MMDEVAPI\{0.0.0.00000000}." & $aRender[$i]
        If RegRead("HKEY_LOCAL_MACHINE64\" & $sEnumRel, "FriendlyName") <> $APP_AUDIO_NAME Then
            WriteProtectedReg($sEnumRel, "FriendlyName", $APP_AUDIO_NAME)
        EndIf
    Next

    For $i = 0 To UBound($aCapture) - 1
        $sRel = "SOFTWARE\Microsoft\Windows\CurrentVersion\MMDevices\Audio\Capture\" & $aCapture[$i] & "\Properties"
        $sCur1 = RegRead("HKEY_LOCAL_MACHINE64\" & $sRel, "{a45c254e-df1c-4efd-8020-67d146a850e0},2")
        $sCur2 = RegRead("HKEY_LOCAL_MACHINE64\" & $sRel, "{b3f8fa53-0004-438e-9003-51a46e139bfc},6")
        If $sCur1 <> $APP_AUDIO_NAME & " In" Or $sCur2 <> $APP_AUDIO_NAME Then
            WriteProtectedReg($sRel, "{a45c254e-df1c-4efd-8020-67d146a850e0},2", $APP_AUDIO_NAME & " In")
            WriteProtectedReg($sRel, "{b3f8fa53-0004-438e-9003-51a46e139bfc},6", $APP_AUDIO_NAME)
        EndIf
    Next

    For $i = 0 To UBound($aMedia) - 1
        $sEnumRel = "SYSTEM\CurrentControlSet\Enum\" & $aMedia[$i]
        If RegRead("HKEY_LOCAL_MACHINE64\" & $sEnumRel, "FriendlyName") <> $APP_AUDIO_NAME Then
            WriteProtectedReg($sEnumRel, "FriendlyName", $APP_AUDIO_NAME)
        EndIf
    Next

    Return $bChanged
EndFunc   ;==>RenameAllVirtualToYunuAudio

Func WriteProtectedReg($sRelSubKey, $sValName, $sValData)
    RegWrite("HKEY_LOCAL_MACHINE64\" & $sRelSubKey, $sValName, "REG_SZ", $sValData)
    If Not @error Then Return True

    If TakeOwnershipAndGrantAdmins($sRelSubKey) Then
        RegWrite("HKEY_LOCAL_MACHINE64\" & $sRelSubKey, $sValName, "REG_SZ", $sValData)
        If Not @error Then Return True
    EndIf
    Return False
EndFunc   ;==>WriteProtectedReg

Func TakeOwnershipAndGrantAdmins($sRelSubKey)
    Local $hToken = _Security__OpenProcessToken(_WinAPI_GetCurrentProcess(), BitOR($TOKEN_ADJUST_PRIVILEGES, $TOKEN_QUERY))
    If $hToken Then
        _Security__SetPrivilege($hToken, "SeTakeOwnershipPrivilege", True)
        _Security__SetPrivilege($hToken, "SeRestorePrivilege", True)
        _WinAPI_CloseHandle($hToken)
    EndIf

    Local $tSidAdmins = _Security__StringSidToSid("S-1-5-32-544")
    If @error Or Not IsDllStruct($tSidAdmins) Then Return False
    Local $pSidAdmins = DllStructGetPtr($tSidAdmins)

    Local Const $iWriteOwner = 0x00080000
    Local Const $iWriteDac = 0x00040000
    Local Const $iSeRegKey = 4
    Local Const $iOwnerSecInfo = 1
    Local Const $iDaclSecInfo = 4

    Local $hKey = _WinAPI_RegOpenKey($HKEY_LOCAL_MACHINE, $sRelSubKey, BitOR($iWriteOwner, $KEY_WOW64_64KEY))
    If @error Or $hKey = 0 Then Return False
    DllCall("advapi32.dll", "dword", "SetSecurityInfo", "handle", $hKey, "int", $iSeRegKey, "dword", $iOwnerSecInfo, "ptr", $pSidAdmins, "ptr", 0, "ptr", 0, "ptr", 0)
    _WinAPI_RegCloseKey($hKey)

    Local $aSD = DllCall("advapi32.dll", "bool", "ConvertStringSecurityDescriptorToSecurityDescriptorW", _
            "wstr", "D:(A;;GA;;;BA)(A;;GA;;;SY)", "dword", 1, "ptr*", 0, "dword*", 0)
    If @error Or Not IsArray($aSD) Or Not $aSD[0] Then Return False
    Local $pSD = $aSD[3]

    Local $aDacl = DllCall("advapi32.dll", "bool", "GetSecurityDescriptorDacl", _
            "ptr", $pSD, "bool*", 0, "ptr*", 0, "bool*", 0)
    If @error Or Not IsArray($aDacl) Or Not $aDacl[0] Or Not $aDacl[2] Then
        _WinAPI_LocalFree($pSD)
        Return False
    EndIf
    Local $pDacl = $aDacl[3]

    $hKey = _WinAPI_RegOpenKey($HKEY_LOCAL_MACHINE, $sRelSubKey, BitOR($iWriteDac, $KEY_WOW64_64KEY))
    If @error Or $hKey = 0 Then
        _WinAPI_LocalFree($pSD)
        Return False
    EndIf
    Local $aRes = DllCall("advapi32.dll", "dword", "SetSecurityInfo", "handle", $hKey, "int", $iSeRegKey, "dword", $iDaclSecInfo, "ptr", 0, "ptr", 0, "ptr", $pDacl, "ptr", 0)
    Local $iDllErr = @error
    _WinAPI_RegCloseKey($hKey)
    _WinAPI_LocalFree($pSD)

    If $iDllErr Or Not IsArray($aRes) Or $aRes[0] <> 0 Then Return False
    Return True
EndFunc   ;==>TakeOwnershipAndGrantAdmins

Func RestoreAudioDefaults($bForceDisable = True)
    If $SVV <> "" And FileExists($SVV) Then
        If $bAudioSwitched Then
            If FileExists($BACKUP_PROFILE) Then
                RunWait('"' & $SVV & '" /LoadProfile "' & $BACKUP_PROFILE & '"', $ENGINE_DIR, @SW_HIDE)
                FileDelete($BACKUP_PROFILE)
            Else
                RunWait('"' & $SVV & '" /SetDefault "Speakers" all', $ENGINE_DIR, @SW_HIDE)
            EndIf
            $bAudioSwitched = False
        EndIf
    EndIf

    If $bForceDisable Then
        DisableAllVirtualOutput()
    EndIf
EndFunc   ;==>RestoreAudioDefaults

Func EnsureAudioOutputReady()
    Local $sOut = "", $iTry = 0, $iErr = 0, $bRecognized = False

    SetBusy("MENYIAPKAN OUTPUT AUDIO...")
    SetProgress(35, "Memeriksa status output audio...")
    $sOut = RunCapture('"' & $CAPTURE & '" --check', 7000)
    $iErr = @error
    If $iErr = 1 Then Return -2
    If $iErr = 2 Then
        KillStrayEngines()
        LogInfo("[!] YunuCapture.exe tidak mengenal --check, lanjut menyambung langsung...")
        Return 0
    EndIf

    $bRecognized = (StringRegExp($sOut, "\[(ACTIVE|DISABLED|NOTPRESENT|UNPLUGGED|OTHER)\]") = 1)
    If StringInStr($sOut, "[ACTIVE]") Then Return 0

    If Not $bRecognized And HasAnyActiveRenderEndpoint() Then
        Return 0
    EndIf

    LogInfo("[!] Output audio aktif belum terdeteksi. Mencoba mengaktifkan...")
    SetProgress(45, "Mengaktifkan output YunuAudio...")
    RemedyEnableOutput()

    For $iTry = 1 To 3
        PumpWait(900)
        If $bRecognized Then
            $sOut = RunCapture('"' & $CAPTURE & '" --check', 7000)
            If StringInStr($sOut, "[ACTIVE]") Then
                LogInfo("[V] Output audio sudah aktif.")
                Return 0
            EndIf
        EndIf
        If HasAnyActiveRenderEndpoint() Then
            LogInfo("[V] Output audio aktif terdeteksi di Windows.")
            Return 0
        EndIf
    Next

    If $bRecognized Then
        LogInfo("[!] Info perangkat dari --check:")
        LogDeviceList($sOut)
    EndIf
    If $bDriverJustInstalled Then
        LogInfo("[!] Driver virtual baru dipasang. Jika gagal menangkap suara, restart PC sekali.")
    EndIf
    LogInfo("Tetap mencoba menyambungkan engine audio...")
    Return 0
EndFunc   ;==>EnsureAudioOutputReady

Func RemedyEnableOutput()
    Local $aMedia = FindVirtualMediaInstanceIds()
    Local $aRender = 0
    Local $i = 0, $sEpId = ""

    If UBound($aMedia) > 0 Then EnableVirtualMediaDevices($aMedia)
    RunCapture('sc start AudioEndpointBuilder', 6000)
    RunCapture('sc start Audiosrv', 6000)

    $aRender = FindVirtualEndpointGuids("Render")
    If $SVV <> "" And FileExists($SVV) Then
        For $i = 0 To UBound($aRender) - 1
            $sEpId = "{0.0.0.00000000}." & $aRender[$i]
            RunWait('"' & $SVV & '" /Enable "' & $sEpId & '"', $ENGINE_DIR, @SW_HIDE)
            RunWait('"' & $SVV & '" /Unmute "' & $sEpId & '"', $ENGINE_DIR, @SW_HIDE)
            RunWait('"' & $SVV & '" /SetVolume "' & $sEpId & '" 100', $ENGINE_DIR, @SW_HIDE)
            RunWait('"' & $SVV & '" /SetDefault "' & $sEpId & '" all', $ENGINE_DIR, @SW_HIDE)
        Next
        $bAudioSwitched = True
    EndIf
EndFunc   ;==>RemedyEnableOutput

Func LogDeviceList($sOut)
    Local $a = StringRegExp($sOut, "(?m)^\s*\[(ACTIVE|DISABLED|NOTPRESENT|UNPLUGGED|OTHER)\]\s*(.*?)\s*$", 3)
    Local $i = 0
    If @error Then
        LogInfo("    (tidak ada daftar perangkat dari --check)")
        Return
    EndIf
    For $i = 0 To UBound($a) - 2 Step 2
        LogInfo("    [" & $a[$i] & "] " & $a[$i + 1])
    Next
EndFunc   ;==>LogDeviceList

