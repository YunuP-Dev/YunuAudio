EndFunc   ;==>SetStateDisconnected

Func LogInfo($sTxt)
    Local $sCur = GUICtrlRead($txtLog)
    Local $iPos = 0

    If StringLen($sCur) > 5000 Then
        $sCur = StringRight($sCur, 3000)
        $iPos = StringInStr($sCur, @LF)
        If $iPos > 0 Then $sCur = StringMid($sCur, $iPos + 1)
    EndIf
    GUICtrlSetData($txtLog, $sCur & "[" & @HOUR & ":" & @MIN & ":" & @SEC & "] " & $sTxt & @CRLF)
    GUICtrlSendMsg($txtLog, 0x00B1, -1, -1)
    GUICtrlSendMsg($txtLog, 0x00B7, 0, 0)
EndFunc   ;==>LogInfo

Func CleanLine($s)
    $s = StringRegExpReplace(StringStripWS($s, 3), "\s*[\r\n]+\s*", " | ")
    If StringLen($s) > 120 Then $s = StringLeft($s, 120) & "..."
    Return $s
EndFunc   ;==>CleanLine

; ==============================================================================
; KELUAR (tampilkan loading reset output & konfigurasi sebelum menutup app)
; ==============================================================================

Func FastExit()
    If $bExiting Then Return
    $bExiting = True

    If $hGUI Then
        SetBusy("MERESET KONFIGURASI...")
        SetProgress(15, "Tunggu, kami sedang mereset seluruh output dan konfigurasi...")
        LogInfo("Menutup: mereset output audio & konfigurasi...")
        PumpWait(120)
    EndIf

    StopEngine()
    KillStrayEngines()
    SetProgress(40, "Tunggu, memutus sambungan perangkat...")

    If $IsConnected And $DeviceSerial <> "" Then
        RunCapture('"' & $ADB & '" -s "' & $DeviceSerial & '" shell am stopservice -n ' & $SVC, 2500)
        RunCapture('"' & $ADB & '" -s "' & $DeviceSerial & '" reverse --remove tcp:' & $PORT, 2500)
    EndIf

    SetProgress(70, "Tunggu, mengembalikan output audio asli Windows...")
    RestoreAudioDefaults(True)

    SetProgress(100, "Reset selesai. Menutup YunuAudio...")
    PumpWait(300)
    If $hGUI Then GUISetState(@SW_HIDE, $hGUI)
    Exit
EndFunc   ;==>FastExit

