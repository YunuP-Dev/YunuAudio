    GUICtrlSetBkColor($boxStatus, 0xC62828)
    GUICtrlSetData($lblStatusText, $sMsg)
    GUICtrlSetData($btnConnect, "SAMBUNGKAN AUDIO")
    GUICtrlSetState($btnConnect, $GUI_ENABLE)
    GUICtrlSetData($lblLevel, "")
    $sLastLevelTxt = ""
EndFunc   ;==>SetStateDisconnected

Func LogInfo($sTxt)
    Local $sCur = GUICtrlRead($txtLog)
    Local $iPos = 0

    If StringLen($sCur) > 5000 Then
        $sCur = StringRight($sCur, 3000)
        $iPos = StringInStr($sCur, @LF)
        If $iPos > 0 Then $sCur = StringMid($sCur, $iPos + 1)
    EndIf
    GUICtrlSetData($txtLog, $sCur & "[" & @HOUR & ":" & @MIN & ":" & @SEC & "] " & $sTxt & @CRLF)
    GUICtrlSendMsg($txtLog, 0x00B1, -1, -1) ; EM_SETSEL -> ke akhir teks
    GUICtrlSendMsg($txtLog, 0x00B7, 0, 0)   ; EM_SCROLLCARET
EndFunc   ;==>LogInfo

Func CleanLine($s)
    $s = StringRegExpReplace(StringStripWS($s, 3), "\s*[\r\n]+\s*", " | ")
    If StringLen($s) > 120 Then $s = StringLeft($s, 120) & "..."
    Return $s
EndFunc   ;==>CleanLine

