Func SetupVirtualAudioSafe()
    Local $tWait = 0
    Local $aRender = 0

    SetBusy("MENYIAPKAN OUTPUT...")
    SetProgress(10, "Memeriksa sisa output & konfigurasi lama...")

    If $SVV = "" Or Not FileExists($SVV) Then
        LogInfo("[!] SoundVolumeView.exe tidak ada: output audio tidak diatur otomatis.")
        SetProgress(100, "Selesai.")
        Return
    EndIf

    ; 1. Jika ada sisa output virtual aktif / cadangan sesi sebelumnya, bersihkan dulu
    If FileExists($BACKUP_PROFILE) Or HasActiveVirtualEndpoint() Then
        LogInfo("Membersihkan sisa konfigurasi output sebelumnya...")
        SetProgress(20, "Membersihkan sisa output sebelumnya...")
        If FileExists($BACKUP_PROFILE) Then
            RunWaitSmooth('"' & $SVV & '" /LoadProfile "' & $BACKUP_PROFILE & '"', $ENGINE_DIR, 20, 28, 800)
            FileDelete($BACKUP_PROFILE)
        EndIf
        DisableAllVirtualEndpoints()
        PumpWait(250)
    EndIf

    ; 2. Simpan cadangan profil audio asli Windows yang sudah bersih
    SetProgress(35, "Mencadangkan konfigurasi audio asli...")
    RunWaitSmooth('"' & $SVV & '" /SaveProfile "' & $BACKUP_PROFILE & '"', $ENGINE_DIR, 35, 45, 700)

    ; 3. Pasang driver virtual jika perangkat virtual belum terpasang di Windows
    $aRender = FindVirtualEndpointGuids("Render")
    If UBound($aRender) = 0 Then
        If $VBCABLE_SETUP <> "" And FileExists($VBCABLE_SETUP) Then
            LogInfo("Memasang output audio YunuAudio (mohon tunggu)...")
            SetProgress(50, "Memasang output audio YunuAudio...")
            $bDriverJustInstalled = True
            RunWaitSmooth('"' & $VBCABLE_SETUP & '" -i -h', $ENGINE_DIR, 50, 75, 6000)

            $tWait = TimerInit()
            While UBound(FindVirtualEndpointGuids("Render")) = 0 And TimerDiff($tWait) < 12000
                PumpWait(500)
                SetProgress(76, "Menunggu Windows mengenali output baru...")
            WEnd
        Else
            LogInfo("[!] Driver output virtual tidak ditemukan di folder Engine.")
        EndIf
    EndIf

    ; 4. Rename menjadi YunuAudio, lalu aktifkan & jadikan default
    $aRender = FindVirtualEndpointGuids("Render")
    If UBound($aRender) > 0 Then
        SetProgress(82, "Mengatur nama output menjadi YunuAudio...")
        RenameVirtualEndpointsToYunuAudio()

        SetProgress(92, "Mengaktifkan output YunuAudio...")
        ActivateAndUnmuteVirtualAudio(True)

        If HasActiveVirtualEndpoint() Then
            LogInfo("Output '" & $APP_AUDIO_NAME & "' aktif dan siap.")
        Else
            LogInfo("Output '" & $APP_AUDIO_NAME & "' disiapkan (dicek ulang saat menyambung).")
        EndIf
    Else
        LogInfo("[!] Output virtual tidak terdeteksi. Memakai output audio bawaan Windows.")
    EndIf

    SetProgress(100, "Output siap.")
    PumpWait(200)
EndFunc   ;==>SetupVirtualAudioSafe

; $bFull = True : aktifkan + unmute + volume 100 + default. False : cukup pastikan aktif & default.
Func ActivateAndUnmuteVirtualAudio($bFull = False)
    Local $aRender = FindVirtualEndpointGuids("Render")
    Local $aIds[2] = [$APP_AUDIO_NAME, $CABLE_NAME]
    Local $i = 0, $sEpId = ""

    If $SVV = "" Or Not FileExists($SVV) Then Return
    If UBound($aRender) = 0 Then Return

    If $bFull Then
        For $i = 0 To UBound($aRender) - 1
            $sEpId = "{0.0.0.00000000}." & $aRender[$i]
            RunWait('"' & $SVV & '" /Enable "' & $sEpId & '"', $ENGINE_DIR, @SW_HIDE)
            RunWait('"' & $SVV & '" /Unmute "' & $sEpId & '"', $ENGINE_DIR, @SW_HIDE)
            RunWait('"' & $SVV & '" /SetVolume "' & $sEpId & '" 100', $ENGINE_DIR, @SW_HIDE)
        Next
    EndIf

    If HasActiveVirtualEndpoint() Then
        For $i = 0 To UBound($aRender) - 1
            $sEpId = "{0.0.0.00000000}." & $aRender[$i]
            RunWait('"' & $SVV & '" /SetDefault "' & $sEpId & '" all', $ENGINE_DIR, @SW_HIDE)
        Next
        $bAudioSwitched = True
    Else
        For $i = 0 To UBound($aIds) - 1
            RunWait('"' & $SVV & '" /Enable "' & $aIds[$i] & '"', $ENGINE_DIR, @SW_HIDE)
        Next
    EndIf
EndFunc   ;==>ActivateAndUnmuteVirtualAudio

Func DisableAllVirtualEndpoints()
    Local $aRender = FindVirtualEndpointGuids("Render")
    Local $aCapture = FindVirtualEndpointGuids("Capture")
    Local $aFallback[3] = [$APP_AUDIO_NAME, $CABLE_NAME, "CABLE Output"]
    Local $i = 0

    If $SVV = "" Or Not FileExists($SVV) Then Return

    For $i = 0 To UBound($aRender) - 1
        RunWait('"' & $SVV & '" /Disable "{0.0.0.00000000}.' & $aRender[$i] & '"', $ENGINE_DIR, @SW_HIDE)
    Next
    For $i = 0 To UBound($aCapture) - 1
        RunWait('"' & $SVV & '" /Disable "{0.0.1.00000000}.' & $aCapture[$i] & '"', $ENGINE_DIR, @SW_HIDE)
    Next
    If UBound($aRender) = 0 And UBound($aCapture) = 0 Then
        For $i = 0 To UBound($aFallback) - 1
            RunWait('"' & $SVV & '" /Disable "' & $aFallback[$i] & '"', $ENGINE_DIR, @SW_HIDE)
        Next
    EndIf
EndFunc   ;==>DisableAllVirtualEndpoints

; Cari semua GUID endpoint virtual (baik bernama CABLE maupun yang sudah direname ke YunuAudio)
Func FindVirtualEndpointGuids($sType = "Render")
    Local $sBase = "HKEY_LOCAL_MACHINE64\SOFTWARE\Microsoft\Windows\CurrentVersion\MMDevices\Audio\" & $sType
    Local $aRes[0]
    Local $i = 1, $sSub = "", $sProp = ""
    Local $sDesc = "", $sIf = "", $sInf = "", $sPnp = "", $iState = 0
    Local $n = 0

    While 1
        $sSub = RegEnumKey($sBase, $i)
        If @error Then ExitLoop

        $sProp = $sBase & "\" & $sSub & "\Properties"
        $sDesc = RegRead($sProp, "{a45c254e-df1c-4efd-8020-67d146a850e0},2")
        $sIf = RegRead($sProp, "{b3f8fa53-0004-438e-9003-51a46e139bfc},6")
        $sInf = RegRead($sProp, "{83da6326-97a6-4088-9453-a1923f573b29},3")
        $sPnp = RegRead($sProp, "{b3f8fa53-0004-438e-9003-51a46e139bfc},2")

        If StringInStr($sDesc, "CABLE") Or StringInStr($sDesc, $APP_AUDIO_NAME) Or _
           StringInStr($sIf, "VB-Audio") Or StringInStr($sIf, $APP_AUDIO_NAME) Or _
           StringInStr($sInf, "vbaudio") Or StringInStr($sPnp, "vbaudio") Then

            $iState = BitAND(Number(RegRead($sBase & "\" & $sSub, "DeviceState")), 0xF)
            If $iState = 1 Or $iState = 2 Or $iState = 8 Then
                $n = UBound($aRes)
                ReDim $aRes[$n + 1]
                $aRes[$n] = $sSub
            EndIf
        EndIf
        $i += 1
    WEnd
    Return $aRes
EndFunc   ;==>FindVirtualEndpointGuids

Func HasActiveVirtualEndpoint()
    Local $sBase = "HKEY_LOCAL_MACHINE64\SOFTWARE\Microsoft\Windows\CurrentVersion\MMDevices\Audio\Render"
    Local $aRender = FindVirtualEndpointGuids("Render")
    Local $i = 0, $iState = 0

    For $i = 0 To UBound($aRender) - 1
        $iState = BitAND(Number(RegRead($sBase & "\" & $aRender[$i], "DeviceState")), 0xF)
        If $iState = 1 Then Return True
    Next
    Return False
EndFunc   ;==>HasActiveVirtualEndpoint

Func HasAnyActiveRenderEndpoint()
    Local $sBase = "HKEY_LOCAL_MACHINE64\SOFTWARE\Microsoft\Windows\CurrentVersion\MMDevices\Audio\Render"
    Local $i = 1, $sSub = "", $iState = 0

    While 1
        $sSub = RegEnumKey($sBase, $i)
        If @error Then ExitLoop
        $iState = BitAND(Number(RegRead($sBase & "\" & $sSub, "DeviceState")), 0xF)
        If $iState = 1 Then Return True
        $i += 1
    WEnd
    Return False
EndFunc   ;==>HasAnyActiveRenderEndpoint

; Ubah nama CABLE Input / VB-Audio Virtual Cable menjadi YunuAudio
Func RenameVirtualEndpointsToYunuAudio()
    Local $aRender = FindVirtualEndpointGuids("Render")
    Local $sBase = "HKEY_LOCAL_MACHINE64\SOFTWARE\Microsoft\Windows\CurrentVersion\MMDevices\Audio\Render"
    Local $i = 0, $sPropKey = "", $sDesc = "", $sIf = "", $bNeedPs = False, $iErr = 0

    For $i = 0 To UBound($aRender) - 1
        $sPropKey = $sBase & "\" & $aRender[$i] & "\Properties"
        $sDesc = RegRead($sPropKey, "{a45c254e-df1c-4efd-8020-67d146a850e0},2")
        $sIf = RegRead($sPropKey, "{b3f8fa53-0004-438e-9003-51a46e139bfc},6")
        If $sDesc = $APP_AUDIO_NAME And $sIf = $APP_AUDIO_NAME Then ContinueLoop

        RegWrite($sPropKey, "{a45c254e-df1c-4efd-8020-67d146a850e0},2", "REG_SZ", $APP_AUDIO_NAME)
        $iErr = @error
        RegWrite($sPropKey, "{b3f8fa53-0004-438e-9003-51a46e139bfc},6", "REG_SZ", $APP_AUDIO_NAME)
        If $iErr <> 0 Or @error <> 0 Then $bNeedPs = True

        If $bNeedPs Then
            RenameViaPowerShell("SOFTWARE\Microsoft\Windows\CurrentVersion\MMDevices\Audio\Render\" & $aRender[$i] & "\Properties", $APP_AUDIO_NAME)
            $bNeedPs = False
        EndIf
    Next
EndFunc   ;==>RenameVirtualEndpointsToYunuAudio

