Func RunWaitSmooth($sCmd, $sWorkDir, $iStartPct, $iEndPct, $iEstMs)
    Local $iPID = Run($sCmd, $sWorkDir, @SW_HIDE)
    Local $hT = TimerInit()
    Local $iCur = $iStartPct
    Local $iSpan = $iEndPct - $iStartPct
    Local $iW = 0

    If $iPID = 0 Then
        SetProgress($iEndPct, GUICtrlRead($lblProgress))
        Return 0
    EndIf

    While ProcessExists($iPID)
        If $iEstMs > 0 And $iSpan > 1 Then
            $iCur = $iStartPct + Int(($iSpan - 1) * (TimerDiff($hT) / $iEstMs))
            If $iCur > $iEndPct - 1 Then $iCur = $iEndPct - 1
            $iW = Int((318 * $iCur) / 100)
            If $iW < 4 Then $iW = 4
            GUICtrlSetPos($prgFill, 21, 191, $iW, 10)
            GUICtrlSetState($prgFill, $GUI_SHOW)
        EndIf
        GUIGetMsg()
        Sleep(35)
    WEnd
    $iW = Int((318 * $iEndPct) / 100)
    If $iW < 4 Then $iW = 4
    GUICtrlSetPos($prgFill, 21, 191, $iW, 10)
    Return 1
EndFunc   ;==>RunWaitSmooth

Func PumpWait($iMs)
    Local $hT = TimerInit()
    While TimerDiff($hT) < $iMs
        GUIGetMsg()
        Sleep(25)
    WEnd
EndFunc   ;==>PumpWait

Func RunCapture($sCmd, $iTimeout = 8000)
    Local $iPID = Run($sCmd, $ENGINE_DIR, @SW_HIDE, BitOR($STDOUT_CHILD, $STDERR_MERGED))
    Local $sOut = ""
    Local $sChunk = ""
    Local $hTimer = 0
    Local $bTimeout = False
    Local $iDrain = 0

    If $iPID = 0 Then Return SetError(1, 0, "")

    $hTimer = TimerInit()
    While ProcessExists($iPID)
        $sChunk = StdoutRead($iPID)
        If $sChunk <> "" Then $sOut &= $sChunk
        If TimerDiff($hTimer) > $iTimeout Then
            $bTimeout = True
            ProcessClose($iPID)
            ExitLoop
        EndIf
        Sleep(15)
    WEnd

    For $iDrain = 1 To 5
        $sChunk = StdoutRead($iPID)
        If @error Or $sChunk = "" Then ExitLoop
        $sOut &= $sChunk
    Next

    If $bTimeout Then Return SetError(2, 0, $sOut)
    Return $sOut
EndFunc   ;==>RunCapture

Func GetPnpUtilPath()
    Local $sSysNative = @WindowsDir & "\Sysnative\pnputil.exe"
    If FileExists($sSysNative) Then Return $sSysNative
    Return "pnputil.exe"
EndFunc   ;==>GetPnpUtilPath

Func LocateEngine()
    Local $targets[3] = [@ScriptDir & "\Engine", @ScriptDir, @ScriptDir & "\.."]
    Local $i = 0
    For $i = 0 To UBound($targets) - 1
        If FileExists($targets[$i] & "\adb.exe") Then Return $targets[$i]
    Next
    Return ""
EndFunc   ;==>LocateEngine

Func LocateFile($sName)
    Local $targets[4] = [$ENGINE_DIR, $ENGINE_DIR & "\Driver", @ScriptDir, @ScriptDir & "\Engine"]
    Local $i = 0
    For $i = 0 To UBound($targets) - 1
        If FileExists($targets[$i] & "\" & $sName) Then Return $targets[$i] & "\" & $sName
    Next
    Return ""
EndFunc   ;==>LocateFile
